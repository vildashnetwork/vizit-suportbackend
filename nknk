import { useState, useRef, useEffect, useCallback } from "react";
import { io, Socket } from "socket.io-client";
import { useNavigate } from "react-router-dom";
import {
  Send, Settings, LogOut, MessageCircle, Paperclip, X, FileText,
  Loader2, Check, CheckCheck, User, MoreVertical, Phone, Video,
  Smile, Mic, CornerDownLeft, Clock, AlertCircle, Menu, ChevronLeft,
  Image as ImageIcon, Film, Download, Share2, Copy, CheckCircle,
  Wifi, WifiOff, Bell, BellOff, Moon, Sun, Globe
} from "lucide-react";

// --- CONFIG ---
const SOCKET_URL = import.meta.env.VITE_SOCKET_URL || "http://localhost:4000";
const CLOUDINARY_UPLOAD_PRESET = "vizit-image";
const CLOUDINARY_CLOUD_NAME = "dgigs6v72";
const API_URL = import.meta.env.VITE_API_URL || "http://localhost:4000/api";

// Types
interface Attachment {
  id: string;
  file: File;
  url?: string;
  preview?: string;
  type: "image" | "video" | "document";
  name?: string;
  size?: number;
  progress?: number;
}

interface Message {
  _id?: string;
  id: string;
  text: string;
  senderId: string;
  receiverId?: string;
  sender: "user" | "agent" | "system";
  timestamp: Date;
  userName?: string;
  userProfile?: string;
  attachments?: Attachment[];
  documents?: string[];
  readistrue?: boolean;
  status?: "sending" | "sent" | "delivered" | "read" | "failed";
  isEdited?: boolean;
  replyTo?: string;
  messageType?: "text" | "image" | "video" | "document";
}

interface User {
  _id: string;
  name: string;
  profile?: string;
  role?: "user" | "admin";
  lastSeen?: Date;
  isOnline?: boolean;
  unreadCount?: number;
  lastMessage?: string;
  lastMessageTime?: Date;
  email?: string;
}

interface TypingStatus {
  byUserId: string;
  isTyping: boolean;
}

interface ChatUser extends User {
  type: 'admin';
}

// Storage keys
const STORAGE_KEYS = {
  USER: "vizit_user",
  USER_ID: "vizit_user_id",
  USER_NAME: "vizit_user_name",
  THEME: "vizit_theme",
  NOTIFICATIONS: "vizit_notifications",
  SOUND: "vizit_sound"
};

export default function VizitChat() {
  // User state
  const [currentUser, setCurrentUser] = useState<User | null>(null);
  const [userName, setUserName] = useState<string>("");
  const [nameInput, setNameInput] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState<string | null>(null);
  const [isLoadingChats, setIsLoadingChats] = useState(false);


  const navigate = useNavigate()
  // Chat state
  const [messages, setMessages] = useState<Message[]>([]);
  const [draft, setDraft] = useState("");
  const [isUploading, setIsUploading] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [attachments, setAttachments] = useState<Attachment[]>([]);
  const [isAdminOnline, setIsAdminOnline] = useState(false);
  const [onlineUsers, setOnlineUsers] = useState<string[]>([]);
  const [typingUsers, setTypingUsers] = useState<Set<string>>(new Set());
  const [activeChat, setActiveChat] = useState<ChatUser | null>(null);
  const [chatHistory, setChatHistory] = useState<ChatUser[]>([]);
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const [uploadProgress, setUploadProgress] = useState<Record<string, number>>({});
  const [isConnected, setIsConnected] = useState(true);
  const [notificationsEnabled, setNotificationsEnabled] = useState(true);
  const [soundEnabled, setSoundEnabled] = useState(() => {
    const saved = localStorage.getItem(STORAGE_KEYS.SOUND);
    return saved !== null ? saved === 'true' : true;
  });
  const [replyingTo, setReplyingTo] = useState<Message | null>(null);
  const [searchTerm, setSearchTerm] = useState("");
  const [filter, setFilter] = useState<"all" | "unread">("all");
  const [isDarkMode, setIsDarkMode] = useState(() => {
    const saved = localStorage.getItem(STORAGE_KEYS.THEME);
    return saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  });

  // Refs
  const socketRef = useRef<Socket | null>(null);
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const textareaRef = useRef<HTMLTextAreaElement>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const typingTimeoutRef = useRef<NodeJS.Timeout>();
  const audioContextRef = useRef<AudioContext | null>(null);
  const messageIdsRef = useRef<Set<string>>(new Set()); // Track all message IDs

  // Initialize Audio Context for sounds
  useEffect(() => {
    try {
      audioContextRef.current = new (window.AudioContext || (window as any).webkitAudioContext)();
    } catch (error) {
      console.warn('Web Audio API not supported:', error);
    }

    return () => {
      audioContextRef.current?.close();
    };
  }, []);

  // Play sound utility
  const playSound = (type: 'send' | 'receive' | 'newTicket') => {
    if (!soundEnabled || !audioContextRef.current) return;

    try {
      const audioContext = audioContextRef.current;
      const oscillator = audioContext.createOscillator();
      const gainNode = audioContext.createGain();

      oscillator.connect(gainNode);
      gainNode.connect(audioContext.destination);

      if (type === 'send') {
        oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
        gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.1);
      } else if (type === 'receive') {
        oscillator.frequency.setValueAtTime(600, audioContext.currentTime);
        oscillator.frequency.setValueAtTime(800, audioContext.currentTime + 0.05);
        gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.15);
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.15);
      } else if (type === 'newTicket') {
        oscillator.frequency.setValueAtTime(400, audioContext.currentTime);
        oscillator.frequency.setValueAtTime(600, audioContext.currentTime + 0.1);
        oscillator.frequency.setValueAtTime(800, audioContext.currentTime + 0.2);
        gainNode.gain.setValueAtTime(0.15, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.3);
      }
    } catch (error) {
      console.warn('Could not play sound:', error);
    }
  };

  // Load user from localStorage on mount
  useEffect(() => {
    const loadUser = async () => {
      try {
        const storedUserId = localStorage.getItem(STORAGE_KEYS.USER_ID);
        const storedUserName = localStorage.getItem(STORAGE_KEYS.USER_NAME);

        if (storedUserId && storedUserName) {
          const response = await fetch(`${API_URL}/user/get-user/${storedUserId}`);
          if (response.ok) {
            const data = await response.json();
            setCurrentUser(data.user);
            setUserName(storedUserName);
          } else {
            localStorage.removeItem(STORAGE_KEYS.USER_ID);
            localStorage.removeItem(STORAGE_KEYS.USER_NAME);
            localStorage.removeItem(STORAGE_KEYS.USER);
          }
        }
      } catch (error) {
        console.error("Failed to load user:", error);
      }
    };
    loadUser();

    if ("Notification" in window && Notification.permission === "default") {
      Notification.requestPermission();
    }

    const notifPref = localStorage.getItem(STORAGE_KEYS.NOTIFICATIONS);
    if (notifPref) {
      setNotificationsEnabled(notifPref === 'true');
    }

    const soundPref = localStorage.getItem(STORAGE_KEYS.SOUND);
    if (soundPref) {
      setSoundEnabled(soundPref === 'true');
    }
  }, []);

  // Apply dark mode
  useEffect(() => {
    if (isDarkMode) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem(STORAGE_KEYS.THEME, isDarkMode ? 'dark' : 'light');
  }, [isDarkMode]);

  // Initialize Socket connection
  useEffect(() => {
    if (!currentUser?._id) return;

    socketRef.current = io(SOCKET_URL, {
      auth: {
        userId: currentUser._id,
        userName: currentUser.name,
        role: currentUser.role || 'user',
        profile: currentUser.profile
      },
      transports: ["websocket", "polling"],
      reconnection: true,
      reconnectionAttempts: 5,
      reconnectionDelay: 1000
    });

    const socket = socketRef.current;

    socket.on("connect", () => {
      console.log("Socket connected");
      setIsConnected(true);
      setError(null);
      showNotification("Connected", "You're back online!", "success");
    });

    socket.on("disconnect", () => {
      console.log("Socket disconnected");
      setIsConnected(false);
      setError("Connection lost. Reconnecting...");
    });

    socket.on("connect_error", (err) => {
      console.error("Socket connection error:", err);
      setIsConnected(false);
      setError("Connection lost. Reconnecting...");
    });

    // Handle new messages - STRICT DUPLICATE PREVENTION
    socket.on("newMessage", (msg: Message) => {
      const messageId = msg._id || msg.id;

      // CRITICAL: If we already have this message, ignore it completely
      if (messageIdsRef.current.has(messageId)) {
        console.log("Duplicate message ignored:", messageId);
        return;
      }

      // Add to tracking set
      messageIdsRef.current.add(messageId);

      const sender = msg.senderId === currentUser?._id ? "user" : "agent";

      const newMsg = {
        ...msg,
        id: messageId,
        timestamp: new Date(msg.timestamp || new Date()),
        sender: sender,
        status: msg.status || (sender === "user" ? "sent" : "delivered")
      };

      // Play sound for received messages
      if (soundEnabled && msg.senderId !== currentUser?._id) {
        playSound('receive');
      }

      // Show notification
      if (notificationsEnabled &&
        msg.senderId !== currentUser?._id &&
        document.hidden) {
        showNotification(
          `New message from ${msg.userName || 'Support'}`,
          msg.text || 'Sent an attachment',
          'info'
        );
      }

      // Add to messages
      setMessages(prev => [...prev, newMsg]);

      // Update sidebar
      setChatHistory(prev =>
        prev.map(chat =>
          chat._id === msg.senderId || chat._id === msg.receiverId
            ? {
              ...chat,
              lastMessage: msg.text || '📎 Attachment',
              lastMessageTime: new Date(),
              unreadCount: msg.senderId !== currentUser?._id ? (chat.unreadCount || 0) + 1 : chat.unreadCount
            }
            : chat
        )
      );
    });

    // Status events
    socket.on("admin_status", (status: { online: boolean }) => {
      setIsAdminOnline(status.online);
    });

    socket.on("getOnlineUsers", (users: string[]) => {
      setOnlineUsers(users);
    });

    socket.on("typingStatus", (status: TypingStatus) => {
      setTypingUsers(prev => {
        const next = new Set(prev);
        if (status.isTyping) {
          next.add(status.byUserId);
        } else {
          next.delete(status.byUserId);
        }
        return next;
      });
    });

    // Read receipt events
    socket.on("messagesRead", (data: { byUserId: string; chatUserId: string; messageIds: string[] }) => {
      setMessages(prev =>
        prev.map(msg =>
          msg.senderId === currentUser?._id &&
            msg.receiverId === data.byUserId &&
            data.messageIds.includes(msg._id || msg.id)
            ? { ...msg, readistrue: true, status: "read" }
            : msg
        )
      );

      setChatHistory(prev =>
        prev.map(chat =>
          chat._id === data.byUserId
            ? { ...chat, unreadCount: 0 }
            : chat
        )
      );
    });

    socket.on("message_status_update", (data: { messageId: string; status: string }) => {
      setMessages(prev =>
        prev.map(msg =>
          msg.id === data.messageId || msg._id === data.messageId
            ? { ...msg, readistrue: data.status === "read", status: data.status as any }
            : msg
        )
      );
    });

    // Load chat history
    loadChatHistory();

    return () => {
      socket.disconnect();
    };
  }, [currentUser, notificationsEnabled, soundEnabled]);

  // Load chat history - ONLY ADMINS
  const loadChatHistory = async () => {
    if (!currentUser?._id) return;

    setIsLoadingChats(true);
    try {
      const response = await fetch(`${API_URL}/messages/users/${currentUser._id}`);
      if (response.ok) {
        const data = await response.json();

        const admins = (data.filteredAdmins || []).map((a: any) => ({
          ...a,
          type: 'admin' as const,
          role: 'admin',
          isOnline: onlineUsers.includes(a._id),
          lastMessage: a.lastMessage,
          lastMessageTime: a.lastMessageTime ? new Date(a.lastMessageTime) : undefined,
          unreadCount: a.unreadCount || 0
        }));

        setChatHistory(admins);

        if (admins.length > 0 && !activeChat) {
          setActiveChat(admins[0]);
        }
      }
    } catch (error) {
      console.error("Failed to load chat history:", error);
    } finally {
      setIsLoadingChats(false);
    }
  };

  // Load messages for active chat
  useEffect(() => {
    if (!activeChat?._id || !currentUser?._id) return;

    const loadMessages = async () => {
      try {
        const response = await fetch(
          `${API_URL}/messages/${activeChat._id}?myId=${currentUser._id}`
        );
        if (response.ok) {
          const data = await response.json();

          // Clear existing message IDs for this chat
          const newMessageIds = new Set<string>();

          const processedMessages = data.map((msg: any) => {
            newMessageIds.add(msg._id);

            const attachments = msg.documents?.map((url: string, index: number) => {
              const urlParts = url.split('/');
              const filename = urlParts[urlParts.length - 1] || `file-${index}`;
              const extension = filename.split('.').pop()?.toLowerCase() || '';

              let type: "image" | "video" | "document" = "document";
              if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(extension)) {
                type = "image";
              } else if (['mp4', 'webm', 'ogg', 'mov', 'avi'].includes(extension)) {
                type = "video";
              }

              return {
                id: `att-${msg._id}-${index}`,
                url,
                type,
                name: filename
              };
            }) || [];

            return {
              ...msg,
              id: msg._id,
              timestamp: new Date(msg.createdAt),
              sender: msg.senderId === currentUser._id ? "user" : "agent",
              readistrue: msg.readistrue || false,
              status: msg.readistrue ? "read" : (msg.senderId === currentUser._id ? "sent" : "delivered"),
              attachments,
              documents: msg.documents || []
            };
          });

          // Update message IDs
          messageIdsRef.current = newMessageIds;

          setMessages(processedMessages);

          const unreadMessageIds = processedMessages
            .filter((msg: Message) => msg.senderId !== currentUser._id && !msg.readistrue)
            .map((msg: Message) => msg._id)
            .filter(Boolean);

          if (unreadMessageIds.length > 0 && socketRef.current) {
            socketRef.current.emit("mark_as_read", {
              messageIds: unreadMessageIds,
              chatUserId: activeChat._id
            });
          }
        }
      } catch (error) {
        console.error("Failed to load messages:", error);
      }
    };

    loadMessages();
  }, [activeChat, currentUser]);

  // Auto-scroll to bottom
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  // Handle typing indicator
  useEffect(() => {
    if (!socketRef.current || !activeChat) return;

    if (draft.trim()) {
      socketRef.current.emit("typing", {
        chatUserId: activeChat._id,
        isTyping: true
      });

      if (typingTimeoutRef.current) {
        clearTimeout(typingTimeoutRef.current);
      }

      typingTimeoutRef.current = setTimeout(() => {
        socketRef.current?.emit("typing", {
          chatUserId: activeChat._id,
          isTyping: false
        });
      }, 2000);
    } else {
      socketRef.current.emit("typing", {
        chatUserId: activeChat._id,
        isTyping: false
      });
    }

    return () => {
      if (typingTimeoutRef.current) {
        clearTimeout(typingTimeoutRef.current);
      }
    };
  }, [draft, activeChat]);

  // Filter chat history
  const filteredChatHistory = chatHistory.filter(chat => {
    const matchesSearch = chat.name.toLowerCase().includes(searchTerm.toLowerCase());
    const matchesFilter = filter === 'all' ? true :
      filter === 'unread' ? (chat.unreadCount || 0) > 0 : true;
    return matchesSearch && matchesFilter;
  });

  // Show notification
  const showNotification = (title: string, body: string, type: 'success' | 'error' | 'info') => {
    if (!notificationsEnabled) return;

    if ("Notification" in window && Notification.permission === "granted") {
      new Notification(title, { body, icon: '/logo.png' });
    }

    if (type === 'error') {
      setError(body);
      setTimeout(() => setError(null), 5000);
    } else if (type === 'success') {
      setSuccess(body);
      setTimeout(() => setSuccess(null), 3000);
    }
  };

  // Cloudinary Upload with Progress
  const uploadToCloudinary = async (file: File): Promise<string> => {
    const formData = new FormData();
    formData.append("file", file);
    formData.append("upload_preset", CLOUDINARY_UPLOAD_PRESET);

    const isVideo = file.type.startsWith("video/");
    const resourceType = isVideo ? "video" : "image";

    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();

      xhr.upload.addEventListener("progress", (event) => {
        if (event.lengthComputable) {
          const progress = Math.round((event.loaded / event.total) * 100);
          setUploadProgress(prev => ({ ...prev, [file.name]: progress }));
        }
      });

      xhr.addEventListener("load", () => {
        if (xhr.status === 200) {
          const data = JSON.parse(xhr.responseText);
          setUploadProgress(prev => {
            const next = { ...prev };
            delete next[file.name];
            return next;
          });
          resolve(data.secure_url);
        } else {
          reject(new Error("Upload failed"));
        }
      });

      xhr.addEventListener("error", () => reject(new Error("Upload failed")));
      xhr.open("POST", `https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/${resourceType}/upload`);
      xhr.send(formData);
    });
  };

  // Handle user login/signup
  const handleIdentify = async () => {
    if (!nameInput.trim()) return;

    setIsLoading(true);
    setError(null);

    try {
      const response = await fetch(`${API_URL}/user/log-add`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: nameInput.trim() })
      });

      if (!response.ok) throw new Error("Failed to create user");

      const data = await response.json();

      localStorage.setItem(STORAGE_KEYS.USER_ID, data.user._id);
      localStorage.setItem(STORAGE_KEYS.USER_NAME, data.user.name);
      localStorage.setItem(STORAGE_KEYS.USER, JSON.stringify(data.user));

      setCurrentUser(data.user);
      setUserName(data.user.name);
      setNameInput("");

      showNotification("Welcome!", `You're now logged in as ${data.user.name}`, "success");
    } catch (error) {
      console.error("Login failed:", error);
      setError("Failed to login. Please try again.");
    } finally {
      setIsLoading(false);
    }
  };

  // Handle sending messages - SIMPLIFIED
  const handleSend = async () => {
    const trimmed = draft.trim();
    if ((!trimmed && attachments.length === 0) || !currentUser || !activeChat) return;

    setIsUploading(true);
    const tempId = crypto.randomUUID();

    // Create temp message with unique ID
    const tempMessage: Message = {
      id: tempId,
      text: trimmed,
      sender: "user",
      senderId: currentUser._id,
      receiverId: activeChat._id,
      timestamp: new Date(),
      userName: currentUser.name,
      userProfile: currentUser.profile,
      attachments: attachments.map(a => ({ id: a.id, type: a.type, name: a.file.name })),
      status: "sending"
    };
    // navigate("/", { replace: true })

    // Add temp message to state
    setMessages(prev => [...prev, tempMessage]);

    // Clear input
    setDraft("");
    const currentAttachments = [...attachments];
    setAttachments([]);


    try {
      // Upload attachments if any
      const uploadedUrls = await Promise.all(
        currentAttachments.map(async (att) => {
          const url = await uploadToCloudinary(att.file);
          return url;
        })
      );

      // Prepare message data
      const messageData = {
        text: trimmed,
        senderId: currentUser._id,
        receiverId: activeChat._id,
        documents: uploadedUrls,
        timestamp: new Date().toISOString(),
        userName: currentUser.name,
        userProfile: currentUser.profile
      };

      // Send via API
      const response = await fetch(`${API_URL}/messages/send/${activeChat._id}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(messageData)
      });

      if (!response.ok) {
        throw new Error("Failed to send message");
      }

      const savedMessage = await response.json();

      // Add to message IDs set
      messageIdsRef.current.add(savedMessage._id);

      // Process attachments for display
      const processedAttachments = savedMessage.documents?.map((url: string, index: number) => ({
        id: `att-${savedMessage._id}-${index}`,
        url,
        type: currentAttachments[index]?.type || "document",
        name: currentAttachments[index]?.name || `file-${index}`
      })) || [];

      // Remove temp message and add the real one
      setMessages(prev => {
        // First, remove the temp message
        const filtered = prev.filter(msg => msg.id !== tempId);
        // Then add the real message
        return [...filtered, {
          ...savedMessage,
          id: savedMessage._id,
          timestamp: new Date(savedMessage.createdAt),
          sender: "user",
          attachments: processedAttachments,
          documents: savedMessage.documents || [],
          status: "sent"
        }];
      });

      // Play sound
      if (soundEnabled) {
        playSound('send');
      }

      // Update sidebar
      setChatHistory(prev =>
        prev.map(chat =>
          chat._id === activeChat._id
            ? {
              ...chat,
              lastMessage: trimmed || '📎 Attachment',
              lastMessageTime: new Date()
            }
            : chat
        )
      );

    } catch (error) {
      console.error("Send failed", error);

      // Mark message as failed
      setMessages(prev =>
        prev.map(msg =>
          msg.id === tempId
            ? { ...msg, status: "failed" }
            : msg
        )
      );

      setError("Failed to send message. Please try again.");
    } finally {
      setIsUploading(false);
    }
  };

  // Handle file selection
  const handleFilePick = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (!files) return;

    Array.from(files).forEach((file) => {
      if (file.size > 10 * 1024 * 1024) {
        setError("File too large. Maximum size is 10MB.");
        return;
      }

      const type = file.type.startsWith("image/") ? "image"
        : file.type.startsWith("video/") ? "video"
          : "document";

      const att: Attachment = {
        id: crypto.randomUUID(),
        file,
        type,
        name: file.name,
        size: file.size
      };

      if (type !== "document") {
        const reader = new FileReader();
        reader.onload = () => {
          att.preview = reader.result as string;
          setAttachments(prev => [...prev, att]);
        };
        reader.readAsDataURL(file);
      } else {
        setAttachments(prev => [...prev, att]);
      }
    });

    e.target.value = "";
  };

  // Remove attachment
  const removeAttachment = (id: string) => {
    setAttachments(prev => prev.filter(a => a.id !== id));
  };

  // Handle logout
  const handleLogout = () => {
    localStorage.removeItem(STORAGE_KEYS.USER_ID);
    localStorage.removeItem(STORAGE_KEYS.USER_NAME);
    localStorage.removeItem(STORAGE_KEYS.USER);
    setCurrentUser(null);
    setUserName("");
    setMessages([]);
    setChatHistory([]);
    setActiveChat(null);
    messageIdsRef.current.clear();
    socketRef.current?.disconnect();
    showNotification("Logged out", "You've been successfully logged out", "info");
  };

  // Download attachment
  const downloadAttachment = (url: string, filename: string) => {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };

  // Format timestamp
  const formatMessageTime = (date: Date) => {
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const minutes = Math.floor(diff / (1000 * 60));

    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes}m ago`;
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };

  const formatChatTime = (date?: Date) => {
    if (!date) return '';
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));

    if (days === 0) {
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    } else if (days === 1) {
      return 'Yesterday';
    } else {
      return date.toLocaleDateString([], { month: 'short', day: 'numeric' });
    }
  };

  // Render message status
  const renderMessageStatus = (msg: Message) => {
    if (msg.sender !== "user") return null;

    switch (msg.status) {
      case "sending":
        return <Clock size={12} className="text-gray-400" />;
      case "sent":
        return <Check size={12} className="text-gray-400" />;
      case "delivered":
        return <CheckCheck size={12} className="text-gray-400" />;
      case "read":
        return <CheckCheck size={12} className="text-blue-500" />;
      case "failed":
        return <AlertCircle size={12} className="text-red-500" />;
      default:
        return msg.readistrue
          ? <CheckCheck size={12} className="text-blue-500" />
          : <Check size={12} className="text-gray-400" />;
    }
  };

  // Copy message to clipboard
  const copyMessage = (text: string) => {
    navigator.clipboard.writeText(text);
    setSuccess("Message copied to clipboard!");
    setTimeout(() => setSuccess(null), 2000);
  };

  // Login screen
  if (!currentUser) {
    return (
      <div className="min-h-screen bg-gradient-to-b from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 flex items-center justify-center p-4">
        <div className="w-full max-w-sm">
          <div className="text-center mb-8">
            <div className="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 text-white mb-3 shadow-lg">
              <MessageCircle size={32} />
            </div>
            <h1 className="text-2xl font-bold text-gray-900 dark:text-white">
              Vizit Support
            </h1>
            <p className="text-sm text-gray-600 dark:text-gray-400 mt-1">
              Connect with our team instantly
            </p>
          </div>

          <div className="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-5">
            <h2 className="text-lg font-semibold text-gray-900 dark:text-white mb-4">
              Enter your name to continue
            </h2>

            {error && (
              <div className="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
                <div className="text-sm text-red-600 dark:text-red-400 flex items-center gap-2">
                  <AlertCircle size={16} />
                  <span>{error}</span>
                </div>
              </div>
            )}

            <div className="space-y-3">
              <input
                type="text"
                value={nameInput}
                onChange={(e) => setNameInput(e.target.value)}
                onKeyPress={(e) => e.key === 'Enter' && handleIdentify()}
                placeholder="Your name"
                className="w-full px-4 py-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none text-sm"
                autoFocus
              />

              <button
                onClick={handleIdentify}
                disabled={isLoading || !nameInput.trim()}
                className="w-full py-3 px-4 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 text-sm"
              >
                {isLoading ? (
                  <>
                    <Loader2 className="animate-spin" size={18} />
                    <span>Please wait...</span>
                  </>
                ) : (
                  <>
                    <MessageCircle size={18} />
                    <span>Start Chatting</span>
                  </>
                )}
              </button>

              <p className="text-xs text-center text-gray-500 dark:text-gray-400 pt-2">
                By continuing, you agree to our Terms of Service
              </p>
            </div>
          </div>

          <button
            onClick={() => setIsDarkMode(!isDarkMode)}
            className="absolute top-4 right-4 p-2 rounded-lg bg-white dark:bg-gray-800 shadow-lg"
          >
            {isDarkMode ? <Sun size={20} /> : <Moon size={20} />}
          </button>
        </div>
      </div>
    );
