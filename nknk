  // Main chat interface
  return (
    <div className="h-screen flex flex-col bg-gray-50 dark:bg-gray-900">
      {/* Top Bar */}
      <div className="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-3 py-2 flex items-center gap-2 shadow-sm">
        <button
          onClick={() => setIsSidebarOpen(!isSidebarOpen)}
          className="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors"
        >
          <Menu size={20} className="text-gray-700 dark:text-gray-300" />
        </button>

        {activeChat ? (
          <div className="flex-1 flex items-center gap-2 min-w-0">
            <div className="relative">
              {activeChat.profile ? (
                <img
                  src={activeChat.profile}
                  alt={activeChat.name}
                  className="w-8 h-8 rounded-full object-cover"
                />
              ) : (
                <div className="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                  <User size={14} className="text-emerald-600 dark:text-emerald-400" />
                </div>
              )}
              <div className={`absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-white dark:border-gray-800 ${onlineUsers.includes(activeChat._id) ? 'bg-green-500' : 'bg-gray-400'
                }`} />
            </div>
            <div className="flex-1 min-w-0">
              <div className="font-medium text-gray-900 dark:text-white truncate text-sm">
                {activeChat.name}
                <span className="ml-2 text-xs bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 px-1.5 py-0.5 rounded-full">
                  Admin
                </span>
              </div>
              {typingUsers.has(activeChat._id) && (
                <div className="text-xs text-emerald-600 dark:text-emerald-400 animate-pulse">
