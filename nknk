              ) : filteredChatHistory.length > 0 ? (
                filteredChatHistory.map((admin) => (
                  <button
                    key={admin._id}
                    onClick={() => {
                      setActiveChat(admin);
                      setIsSidebarOpen(false);
                    }}
                    className={`
                      w-full p-3 flex items-center gap-2 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors
                      ${activeChat?._id === admin._id ? 'bg-emerald-50 dark:bg-emerald-900/20 border-l-4 border-emerald-600' : ''}
                    `}
                  >
                    <div className="relative">
                      {admin.profile ? (
                        <img
                          src={admin.profile}
                          alt={admin.name}
                          className="w-10 h-10 rounded-full object-cover"
                        />
                      ) : (
                        <div className="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                          <User size={16} className="text-emerald-600 dark:text-emerald-400" />
                        </div>
                      )}
                      <div className={`absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-white dark:border-gray-800 ${onlineUsers.includes(admin._id) ? 'bg-green-500' : 'bg-gray-400'
                        }`} />
                    </div>
                    <div className="flex-1 min-w-0 text-left">
                      <div className="flex items-center justify-between gap-1">
                        <div className="font-medium text-gray-900 dark:text-white truncate text-sm">
                          {admin.name}
                          <span className="ml-1 text-[10px] bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 px-1 py-0.5 rounded-full">
                            Admin
                          </span>
                        </div>
                        {admin.lastMessageTime && (
                          <span className="text-[10px] text-gray-500 dark:text-gray-400 whitespace-nowrap">
                            {formatChatTime(admin.lastMessageTime)}
                          </span>
                        )}
                      </div>
                      <div className="flex items-center justify-between">
                        <div className="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[120px]">
                          {typingUsers.has(admin._id) ? (
                            <span className="text-emerald-600 dark:text-emerald-400">Typing...</span>
                          ) : (
                            admin.lastMessage || 'No messages yet'
                          )}
                        </div>
                        {admin.unreadCount ? (
                          <span className="min-w-[18px] h-[18px] flex items-center justify-center bg-emerald-600 text-white text-[10px] font-medium rounded-full">
                            {admin.unreadCount}
                          </span>
                        ) : null}
                      </div>
                    </div>
                  </button>
                ))
              ) : (
                <div className="p-4 text-center">
                  <MessageCircle size={24} className="mx-auto mb-2 text-gray-400" />
                  <div className="text-sm text-gray-500 dark:text-gray-400">No admins found</div>
                </div>
              )}
            </div>

            <div className="p-3 border-t border-gray-200 dark:border-gray-700">
              <button
                onClick={handleLogout}
                className="w-full py-2 px-3 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors flex items-center justify-center gap-2 text-sm"
              >
                <LogOut size={16} />
                <span>Logout</span>
              </button>
            </div>
          </div>
        </div>

        {/* Chat Area */}
        <div className="flex-1 flex flex-col bg-gray-50 dark:bg-gray-900">
          {activeChat ? (
            <>
              <div className="flex-1 overflow-y-auto p-3 space-y-3">
                {messages.length > 0 ? (
                  messages.map((msg, index) => {
                    const isUser = msg.sender === "user";
                    const showAvatar = index === 0 ||
                      messages[index - 1]?.sender !== msg.sender;

                    return (
                      <div
                        key={msg.id || msg._id || index}
                        className={`flex ${isUser ? 'justify-end' : 'justify-start'} items-end gap-1`}
                      >
                        {!isUser && showAvatar && (
                          <div className="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
                            <MessageCircle size={12} className="text-emerald-600 dark:text-emerald-400" />
                          </div>
                        )}
                        {!isUser && !showAvatar && <div className="w-6" />}

                        <div className="max-w-[85%] sm:max-w-[70%]">
                          {showAvatar && !isUser && msg.sender !== 'system' && (
                            <div className="text-[10px] text-gray-500 dark:text-gray-400 ml-1 mb-0.5">
                              {msg.userName || 'Admin'}
                            </div>
                          )}

                          <div
                            className={`
                              rounded-2xl px-3 py-2 relative group
                              ${isUser
                                ? 'bg-emerald-600 text-white rounded-br-none'
                                : msg.sender === 'system'
                                  ? 'bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-center text-xs'
                                  : 'bg-white dark:bg-gray-800 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 rounded-bl-none'
                              }
                            `}
                          >
                            {msg.text && (
                              <div className="text-sm leading-relaxed whitespace-pre-wrap break-words">
                                {msg.text}
                              </div>
                            )}

                            {(msg.attachments && msg.attachments.length > 0) && (
                              <div className="space-y-1.5 mt-1.5">
                                {msg.attachments.map((att: any) => (
                                  <div key={att.id} className="space-y-1">
                                    {att.type === "image" && (
                                      <div className="relative group">
                                        <img
                                          src={att.url}
                                          alt={att.name || "Image"}
                                          className="rounded-lg max-h-40 w-full object-cover cursor-pointer hover:opacity-90 transition"
                                          onClick={() => window.open(att.url, '_blank')}
                                        />
                                        <button
                                          onClick={() => downloadAttachment(att.url, att.name)}
                                          className="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition bg-black/50 text-white p-1.5 rounded-full"
                                        >
                                          <Download size={14} />
                                        </button>
                                      </div>
                                    )}
                                    {att.type === "video" && (
                                      <video
                                        src={att.url}
                                        controls
                                        className="rounded-lg max-h-40 w-full"
                                      />
